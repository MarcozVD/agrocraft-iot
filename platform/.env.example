# Copiar a .env. scripts/setup.sh rellena con claves aleatorias todo lo que quede vacío.
# NUNCA subir .env al repositorio.

SITE_HOST=agrocraft.northcentralus.cloudapp.azure.com

# Ubicación que consultan los dispositivos de API (Bucaramanga)
LATITUDE=7.119
LONGITUDE=-73.123

# Plataforma
INFLUX_ADMIN_PASS=
INFLUX_TOKEN=
GRAFANA_ADMIN_PASS=
RCON_PASSWORD=

# Servicio de control: usuario operador del panel /iot/ y token del webhook de alertas de Grafana
CONTROL_USER=operador
CONTROL_PASS=
ALERT_TOKEN=
AMQP_PASS=

# Bróker MQTT: una clave por usuario (servicios y dispositivos)
MQTT_PASS_TELEGRAF=
MQTT_PASS_OPERATOR=
MQTT_PASS_MC_BRIDGE=
MQTT_PASS_API_CLIMA=
MQTT_PASS_API_AIRE=
MQTT_PASS_API_SUELO=
MQTT_PASS_API_PRONOSTICO=
MQTT_PASS_DS_INVERNADERO=
MQTT_PASS_DS_ENERGIA=
MQTT_PASS_GW_PC_01=
MQTT_PASS_PHONE_01=
MQTT_PASS_ESP32_01=

# Notificaciones (opcionales): Telegram (@BotFather) y Discord (webhook del canal)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Analista con IA (opcional). Proveedor compatible con OpenAI (p. ej. TokenHarbor + DeepSeek):
ANALYST_BASE_URL=https://tokenharbor.ai/v1
ANALYST_MODEL=deepseek-v4.1-flash:free
ANALYST_API_KEY=
# Alternativa: Claude (se usa solo si ANALYST_BASE_URL está vacío)
ANTHROPIC_API_KEY=
