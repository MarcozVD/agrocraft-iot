# Entrada pública de AgroCraft. Caddy obtiene y renueva el certificado TLS por su cuenta.
{$SITE_HOST} {
	# Todo comprimido salvo el flujo en vivo del gemelo 3D (Server-Sent Events: cada mensaje sale al instante)
	@comprimible not path /iot/api/stream
	encode @comprimible zstd gzip

	# Mapa web del mundo (squaremap, dentro del servidor de Minecraft)
	redir /map /map/
	handle_path /map/* {
		root * /srv/map
		file_server
	}

	# Servicio de control: panel de retroceso, API REST, ingesta HTTPS y webhook de alertas
	handle /iot* {
		reverse_proxy control:8080
	}

	# MQTT sobre WebSocket: el TLS termina aquí y sigue en claro por la red interna
	handle /mqtt {
		reverse_proxy mosquitto:9001
	}

	# Grafana
	handle {
		reverse_proxy grafana:3000
	}
}
