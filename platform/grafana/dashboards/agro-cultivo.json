        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Comandos (ack)",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-agro"
        },
        "enable": true,
        "iconColor": "#FF9830",
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"events\" and r.channel == \"ack\")\n  |> filter(fn: (r) => r.device =~ /mc-parcela.*|mc-tanque|mc-silo/)\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, text: r.device + \": \" + r._value, tags: r.device}))"
        }
      },
      {
        "name": "Eventos",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-agro"
        },
        "enable": true,
        "iconColor": "#B877D9",
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"events\" and r.channel == \"event\")\n  |> filter(fn: (r) => r.device =~ /mc-parcela.*|mc-tanque|mc-silo/)\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, text: r.device + \": \" + r._value, tags: r.device}))"
        }
      }
    ]
