    {
      "id": 32,
      "type": "timeseries",
      "title": "Gemelo: rendimiento del servidor",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-agro"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influx-agro"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device == \"mc-server\")\n  |> filter(fn: (r) => r._field == \"tps\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"device\"])"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influx-agro"
          },
          "refId": "B",
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device == \"mc-server\")\n  |> filter(fn: (r) => r._field == \"mspt\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 600000,
            "stacking": {
              "mode": "none"
            },
            "axisBorderShow": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "displayName": "${__field.labels._field} · ${__field.labels.device}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
