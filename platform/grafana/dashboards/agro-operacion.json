    {
      "id": 35,
      "type": "timeseries",
      "title": "Mensajes perdidos por dispositivo (huecos en seq)",
      "description": "Cada mensaje lleva un contador seq. Un salto mayor que 1 indica mensajes que no llegaron (QoS 1 los reintenta; un reinicio del dispositivo reinicia el contador).",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-agro"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influx-agro"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"seq\")\n  |> group(columns: [\"device\"])\n  |> difference(nonNegative: true)\n  |> map(fn: (r) => ({r with _value: if r._value > 1.0 then r._value - 1.0 else 0.0}))\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 600000,
            "stacking": {
              "mode": "none"
            },
            "axisBorderShow": false
          },
          "displayName": "${__field.labels.device}",
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "min",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
